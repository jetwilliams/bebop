# Bebop configuration.
# Copy to ~/.config/bebop/studio.env (or set STUDIO_CONFIG to another path) and edit.
# Every script in scripts/ reads this file. Do NOT put secrets in it.

# The context pod: the studio folder with AGENTS.md, MANAGER.md, memory/ and projects/.
# On macOS, keep it OUT of ~/Desktop, ~/Documents and ~/Downloads: launchd jobs cannot read those folders.
STUDIO_DIR="$HOME/studio"

# tmux session name.
STUDIO_SESSION="studio"

# The manager window and the command that starts the manager agent in it.
# The "||" fallback starts a fresh conversation the first time, when there is nothing to continue.
MANAGER_WINDOW="manager"
MANAGER_CMD="claude --continue --channels plugin:telegram@claude-plugins-official || claude --channels plugin:telegram@claude-plugins-official"

# Pattern the watchdog uses (pgrep -f) to decide whether the manager is running.
MANAGER_MATCH="claude.*--channels"

# Extra windows that studio-up.sh creates, one per line: name|working directory|command
# The command is optional. Leave it empty to get a plain shell in that folder.
# Project agents are usually started by hand (so you can resume the right conversation), so the
# examples below only open a shell in each project folder.
STUDIO_WINDOWS="
shell|$HOME/studio|
project-a|$HOME/studio/projects/project-a|
project-b|$HOME/studio/projects/project-b|
"

# Where the scripts write their logs.
LOG_DIR="$HOME/.local/state/bebop"

# Backup (scripts/backup.sh)
# BACKUP_VOLUME must exist (be mounted) or the backup is skipped. On Linux this might be /media/$USER/backup.
BACKUP_VOLUME="/Volumes/BACKUP"
BACKUP_DEST="/Volumes/BACKUP/bebop-backup"
# Also copy the agents' own memory folders (Claude Code keeps per-project memory under ~/.claude/projects).
BACKUP_AGENT_MEMORY="yes"
